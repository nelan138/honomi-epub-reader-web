{
   "editor.fontFamily": "Cascadia Code, Fira Code, monospace",
   "editor.formatOnSave": true,
   "cSpell.ignorePaths": ["tests/**"],
   "cSpell.words": [
      "Cascadia",
      "dbaeumer",
      "denoland",
      "dexie",
      "dtbncx",
      "epub",
      "esbenp",
      "fflate",
      "Fira",
      "Honomi",
      "idref",
      "itemref",
      "maxlength",
      "OEBPS",
      "parsererror",
      "rgba",
      "rootfile",
      "vite"
   ],
   "eslint.enable": false,
   "deno.enable": true,
   "deno.lint": true,
   "editor.insertSpaces": true,
   "editor.tabSize": 3,

   "[typescript]": {
      "editor.defaultFormatter": "denoland.vscode-deno"
   },
   "[javascript]": {
      "editor.defaultFormatter": "denoland.vscode-deno"
   },
   "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
   },
   "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
   },
   "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
   },
   "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
   },
   "files.associations": {
      "*.css": "tailwindcss"
   }
}
