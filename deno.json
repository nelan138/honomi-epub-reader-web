{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "fflate": "npm:fflate@^0.8.3",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "npm:vite@^8.2.1"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 3,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "always",
    "include": ["src/"],
    "exclude": ["**/test/**"],
    "trailingCommas": "onlyMultiLine"
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["**/test/**"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-unused-vars", "ban-untagged-todo"]
    }
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  }
}